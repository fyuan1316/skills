# node-ssh-bootstrap — per-environment parameters.
# Copy to env.<environment> and `source` it (or pass the same values as CLI flags).
# "Switch environments" = point these at a different jump host + cluster wrapper.
#
#   source kbs/fy-skills/node-ssh-bootstrap/env.kubeos2
#   bash kbs/fy-skills/node-ssh-bootstrap/scripts/bootstrap-ssh.sh --nodes auto

# Jump/exec host: where the kubectl wrapper runs and which can reach the nodes'
# SSH ports (it is the ProxyJump for `ssh <node>`). Needs passwordless ssh from here.
export SSH_HOST=npuserver

# kubectl invocation on SSH_HOST, bound to the TARGET cluster. May include args.
# (reference env: the `kos2` wrapper = kubectl --kubeconfig=… --context=direct-connect)
export KUBECTL=kos2

# Debug container image — must have a shell AND be pullable BY THE CLUSTER.
# "auto" picks an already-present 3rdparty/kubectl|busybox|toolbox image (air-gap safe).
# Reference env explicit value: 192.168.111.127:11443/3rdparty/kubectl:v4.3.1
export DEBUG_IMAGE=auto

# libvirt network whose DHCP leases map VM name → IP (for discover.sh).
export LIBVIRT_NET=default

# Public key to install for passwordless login (local path on the machine you run from).
export PUBKEY_FILE=$HOME/.ssh/id_ed25519.pub

# authorized_keys path ON the node (prefixed with /host inside the debug pod).
export AUTHKEYS=/root/.ssh/authorized_keys

# Node list: "auto" = every node from `kubectl get nodes`, or "kubeos2 kubeos3".
export NODES=auto
