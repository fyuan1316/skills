# Required: platform credentials. Prefer a platform token when available.
# PLATFORM_TOKEN='your-platform-token'

# Alternative: username/password login.
PLATFORM_USERNAME='your-username'
PLATFORM_PASSWORD='your-password'

# Optional: default platform address. If empty, sync-bundle will try to discover it with kubectl.
# PLATFORM_ADDRESS='https://platform.example.com'

# Optional: ACP resource name used as a fallback for platform discovery.
# ACP_NAME='your-acp-name'
# ACP_NAMESPACE='idp'

# Optional: clusters to sync to.
CLUSTERS='global'

# Optional: image packaging behavior.
SKIP_PACKAGE_IMAGES='true'
PACKAGE_PLATFORMS='dual'

# Optional: rewrite registry prefixes before packaging.
REGISTRY_REWRITE_FROM='build-harbor.alauda.cn'
REGISTRY_REWRITE_TO='target-registry.example.com'

# Optional: violet binary settings.
VIOLET_VERSION='latest'
# VIOLET_BASE_URL='http://package-minio.alauda.cn:9199/packages/violet'

# Optional: verbose logs for violet itself.
VIOLET_DEBUG='false'
