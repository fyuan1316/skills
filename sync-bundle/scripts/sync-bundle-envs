#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  sync-bundle-envs <artifact> <env-or-alias> [cluster]

Examples:
  sync-bundle-envs build-harbor.alauda.cn/foo/bar:v1 dev kubeos
  sync-bundle-envs build-harbor.alauda.cn/foo/bar:v1 dev-global-v100
  sync-bundle-envs build-harbor.alauda.cn/foo/bar:v1 dev-global-compute microos
  sync-bundle-envs build-harbor.alauda.cn/foo/bar:v1 p100
  sync-bundle-envs build-harbor.alauda.cn/foo/bar:v1 t4
  sync-bundle-envs build-harbor.alauda.cn/foo/bar:v1 kubeos

Resolution:
  dev/default          -> envs/dev-global-default
  v100/dev-v100        -> envs/dev-global-v100
  p100/card-p100       -> envs/dev-global-compute, cluster compute-x86
  t4/4090/rtx4090      -> envs/dev-global-compute, cluster microos
  kubeos/microos/...   -> the unique dev-*/clusters/<cluster>.env match

The script creates a temporary violet-sync profile and then delegates to
scripts/sync-bundle. It does not create persistent ~/.config/violet-sync files.
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

ARTIFACT="${1:-}"
TARGET="${2:-}"
REQUESTED_CLUSTER="${3:-}"

if [[ -z "${ARTIFACT}" || -z "${TARGET}" ]]; then
  usage
  exit 1
fi

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
SYNC_BUNDLE_BIN="${SYNC_BUNDLE_BIN:-${SCRIPT_DIR}/sync-bundle}"
ENVS_ROOT="${ENVS_ROOT:-/Volumes/macOS-2/Users/yuan/Dev/tools/envs}"

abort() {
  echo "sync-bundle-envs: $*" >&2
  exit 1
}

resolve_dev_dir() {
  local target="$1"
  case "${target}" in
    dev|default|dev-default|dev-global-default)
      printf '%s\n' "${ENVS_ROOT}/dev-global-default"
      return 0
      ;;
    v100|dev-v100|dev-global-v100)
      printf '%s\n' "${ENVS_ROOT}/dev-global-v100"
      return 0
      ;;
  esac

  if [[ -d "${ENVS_ROOT}/${target}" && "${target}" == dev-* ]]; then
    printf '%s\n' "${ENVS_ROOT}/${target}"
    return 0
  fi

  return 1
}

find_cluster_dev_dir() {
  local cluster="$1"
  local matches=()
  local f=""

  shopt -s nullglob
  for f in "${ENVS_ROOT}"/dev-*/clusters/"${cluster}.env"; do
    matches+=("$(cd -- "$(dirname -- "${f}")/.." && pwd)")
  done
  shopt -u nullglob

  case "${#matches[@]}" in
    0) return 1 ;;
    1) printf '%s\n' "${matches[0]}"; return 0 ;;
    *)
      abort "cluster '${cluster}' is present in multiple dev envs: ${matches[*]}"
      ;;
  esac
}

DEV_DIR=""
CLUSTER="${REQUESTED_CLUSTER}"

case "${TARGET}" in
  p100|card-p100)
    TARGET="dev-global-compute"
    CLUSTER="${CLUSTER:-compute-x86}"
    ;;
  t4|card-t4|4090|rtx4090|card-rtx4090)
    TARGET="dev-global-compute"
    CLUSTER="${CLUSTER:-microos}"
    ;;
esac

if DEV_DIR="$(resolve_dev_dir "${TARGET}")"; then
  :
elif [[ -z "${REQUESTED_CLUSTER}" ]] && DEV_DIR="$(find_cluster_dev_dir "${TARGET}")"; then
  CLUSTER="${TARGET}"
elif [[ "${TARGET}" == dev-* && -z "${REQUESTED_CLUSTER}" ]]; then
  candidate="${TARGET#dev-}"
  if DEV_DIR="$(find_cluster_dev_dir "${candidate}")"; then
    CLUSTER="${candidate}"
  else
    abort "cannot resolve target '${TARGET}' as a dev env or cluster alias"
  fi
else
  abort "cannot resolve target '${TARGET}' as a dev env or cluster alias"
fi

[[ -d "${DEV_DIR}" ]] || abort "missing dev env dir: ${DEV_DIR}"
[[ -f "${DEV_DIR}/env" ]] || abort "missing ${DEV_DIR}/env"
[[ -f "${DEV_DIR}/platform.env" ]] || abort "missing ${DEV_DIR}/platform.env"

if [[ -n "${CLUSTER}" && ! -f "${DEV_DIR}/clusters/${CLUSTER}.env" ]]; then
  abort "cluster '${CLUSTER}' is not recorded under ${DEV_DIR}/clusters"
fi

# Avoid accidental broad pushes. If a dev env has multiple default clusters,
# require the user or agent to name the cluster explicitly.
DEV_ENV_CLUSTERS=""
# shellcheck disable=SC1090
source "${DEV_DIR}/env"
if [[ -z "${CLUSTER}" && "${DEV_ENV_CLUSTERS}" == *,* ]]; then
  abort "target '${TARGET}' resolves to multiple clusters (${DEV_ENV_CLUSTERS}); specify one cluster"
fi

tmp_config_home="$(mktemp -d)"
cleanup() {
  rm -rf "${tmp_config_home}"
}
trap cleanup EXIT

dev_slug="$(basename "${DEV_DIR}" | tr -c 'A-Za-z0-9_.-' '-' | sed 's/-$//')"
profile="envs-${dev_slug}-${CLUSTER:-default}-$$"
profile_dir="${tmp_config_home}/violet-sync"
profile_file="${profile_dir}/${profile}.env"
mkdir -p "${profile_dir}"

{
  printf 'source %q\n' "${DEV_DIR}/env"
  printf 'source %q\n' "${DEV_DIR}/platform.env"
  if [[ -n "${CLUSTER}" ]]; then
    printf 'CLUSTERS=%q\n' "${CLUSTER}"
  fi
} >"${profile_file}"

log_cluster="${CLUSTER:-${DEV_ENV_CLUSTERS:-global}}"
printf '[sync-bundle-envs] env=%s\n' "$(basename "${DEV_DIR}")" >&2
printf '[sync-bundle-envs] cluster=%s\n' "${log_cluster}" >&2

XDG_CONFIG_HOME="${tmp_config_home}" "${SYNC_BUNDLE_BIN}" "${ARTIFACT}" "${profile}"
